{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "kill-port": "powershell -Command \"netstat -ano | Select-String ':2063' | ForEach-Object { $parts = $_ -split '\\s+'; $pid = $parts[-1]; if ($pid -match '^\\d+$') { taskkill /F /PID $pid 2>$null } }; exit 0\"",
    "dev": "npm run kill-port && vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.11.1",
    "element-plus": "^2.14.2",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "vue": "^3.4.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "sass": "^1.101.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
